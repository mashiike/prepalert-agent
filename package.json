{
  "name": "prepalert-agent",
  "version": "0.0.1",
  "description": "CLI agent tool using Claude Agent SDK",
  "type": "module",
  "bin": {
    "prepalert-agent": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "compile": "bun build --compile --minify src/index.ts --outfile prepalert-agent",
    "compile:lambda": "bun build --compile --minify --target=bun-linux-x64 src/index.ts --outfile bootstrap",
    "start": "bun run src/index.ts",
    "dev": "bun src/index.ts"
  },
  "keywords": [],
  "author": "mashiike",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.175",
    "@aws-sdk/client-s3": "^3.1071.0",
    "@aws-sdk/client-sqs": "^3.1071.0",
    "@aws-sdk/s3-request-presigner": "^3.1071.0",
    "@google-cloud/tasks": "^6.2.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.219.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.219.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.219.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-logs": "^0.219.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "commander": "^15.0.0",
    "fflate": "^0.8.3",
    "jose": "^6.2.3",
    "yaml": "^2.9.0"
  }
}
